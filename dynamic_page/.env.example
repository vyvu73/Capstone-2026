# Copy this file to .env and fill in whichever databases you want to use.
# Both are optional. With neither set, results are kept in memory only.

# MongoDB Atlas connection string.
#   mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=typing_speed_test
MONGODB_COLLECTION=results

# Postgres connection string.
#   postgresql://postgres:PASSWORD@localhost:5432/typing_speed_test
DATABASE_URL=

# Port the API listens on.
PORT=4000
