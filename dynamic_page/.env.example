# Copy this file to `.env` and fill in whichever databases you want to use.
#
# Both are optional and independent. Every finished test is written to EVERY
# database configured here, and the Past runs list can be read from either one.
# With neither set, the server falls back to an in-memory store so the app
# still runs -- results are just lost on restart.

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
# Atlas UI -> your cluster -> "Connect" -> "Drivers" -> Node.js -> copy the URI.
# Replace <password> with your database user's password (URL-encode any of
# @ : / ? # [ ] % in it), and make sure your IP is allowed under Network Access.
#
#   mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=typing_speed_test
MONGODB_COLLECTION=results

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Local:  postgresql://postgres:PASSWORD@localhost:5432/typing_speed_test
# Hosted: copy the connection string from Neon / Supabase / Railway.
# The `results` table is created automatically on boot -- no migration to run.
# TLS is enabled automatically for any non-localhost host.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Port the API server listens on. The Vite dev server (3000) proxies /api here.
# ---------------------------------------------------------------------------
PORT=4000
